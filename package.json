{
  "name": "@dr460nf1r3/eslint-rules",
  "version": "0.5.0",
  "description": "Opinionated ESLint rules for TypeScript, Angular and NestJS code, with lite, recommended and full presets",
  "keywords": [
    "eslint",
    "eslintplugin",
    "eslint-plugin",
    "angular",
    "nestjs",
    "typescript"
  ],
  "author": "Nico Jensch <root@dr460nf1r3.org>",
  "license": "MIT",
  "homepage": "https://github.com/dr460nf1r3/eslint-rules#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dr460nf1r3/eslint-rules.git"
  },
  "bugs": "https://github.com/dr460nf1r3/eslint-rules/issues",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "build": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.lib.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint --max-warnings 0 .",
    "format": "prettier --write \"**/*.{ts,mts,json,md,yml}\"",
    "format-check": "prettier --check \"**/*.{ts,mts,json,md,yml}\"",
    "update-rule-configs": "tsx tools/generate-configs.ts",
    "update-rule-docs": "tsx tools/generate-rule-docs.ts",
    "update-rule-lists": "tsx tools/generate-rule-lists.ts",
    "update-generated": "pnpm update-rule-configs && pnpm update-rule-docs && pnpm update-rule-lists",
    "check-generated": "tsx tools/generate-configs.ts --check && tsx tools/generate-rule-docs.ts --check && tsx tools/generate-rule-lists.ts --check",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "@angular-eslint/eslint-plugin": "^22.0.0",
    "@angular-eslint/eslint-plugin-template": "^22.0.0",
    "@angular-eslint/template-parser": "^20.0.0 || ^21.0.0 || ^22.0.0",
    "@stylistic/eslint-plugin": "^5.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@typescript-eslint/utils": "^8.0.0",
    "eslint": "^9.0.0 || ^10.0.0",
    "typescript": "*",
    "typescript-eslint": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "@angular-eslint/eslint-plugin": {
      "optional": true
    },
    "@angular-eslint/eslint-plugin-template": {
      "optional": true
    },
    "@angular-eslint/template-parser": {
      "optional": true
    }
  },
  "devDependencies": {
    "@angular-eslint/eslint-plugin": "^22.5.0",
    "@angular-eslint/eslint-plugin-template": "^22.5.0",
    "@angular-eslint/template-parser": "^22.5.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^26.6.4",
    "@typescript-eslint/parser": "^8.71.1",
    "@typescript-eslint/rule-tester": "^8.71.1",
    "@typescript-eslint/utils": "^8.71.1",
    "eslint": "^10.12.0",
    "jiti": "^2.7.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=26",
      "onFail": "error"
    }
  }
}
